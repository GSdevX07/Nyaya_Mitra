# Nyaya Mitra — Backend Environment Configuration
# Copy this file to .env and fill in real values before running.

# ── REQUIRED ───────────────────────────────────────────────────────────────────
# Groq API key — primary cloud LLM provider (Tier 1)
# Get yours free at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# ── OPTIONAL (Ollama local edge LLM — Tier 2 fallback) ────────────────────────
# Ollama must be running locally: https://ollama.com
# Pull the model first:  ollama pull granite4.1:8b
# Then start the server: ollama serve  (or the desktop app keeps it running)
#
# If these are not set, the defaults below are used automatically.
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=granite4.1:8b
OLLAMA_TIMEOUT=60

# ── REQUIRED (Supabase - Database & Auth) ───────────────────────────────────────
# Get yours from Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_KEY=your_supabase_service_key_here

# ── OPTIONAL (Watsonx - Tier 1.5 Cloud LLM) ─────────────────────────────────────
# For enterprise-grade deterministic LLM fallback
WATSONX_API_KEY=your_watsonx_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
# Set these four fields to use IBM Granite through watsonx.ai before Groq.
WATSONX_MODEL_ID=your_ibm_granite_model_id_here
WATSONX_URL=https://your-region.ml.cloud.ibm.com

# Optional legal-corpus and handwriting/OCR integrations. Commands receive
# {input} and {output} absolute file paths and must write UTF-8 text to output.
IBM_DPK_COMMAND=
HANDWRITING_OCR_COMMAND=
